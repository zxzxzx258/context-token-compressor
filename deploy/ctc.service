[Unit]
Description=Context Token Compressor proxy and dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ctc
Group=ctc
EnvironmentFile=/etc/ctc/ctc.env
WorkingDirectory=/opt/ctc/app
Environment=CTC_PROXY_HOST=127.0.0.1
Environment=CTC_PROXY_PORT=8787
Environment=CTC_DASHBOARD_HOST=127.0.0.1
Environment=CTC_DASHBOARD_PORT=8788
Environment=CTC_DB_PATH=/var/lib/ctc/ctc.sqlite3
Environment=CTC_PROVIDER_CONFIG_PATH=/var/lib/ctc/providers.json
Environment=CTC_RUNTIME_CONFIG_PATH=/var/lib/ctc/runtime_config.json
Environment=CTC_TRUST_ENV_PROXY=0
Environment=CTC_ALLOW_PROFILE_HEADER=0
Environment=CTC_ALLOW_SELF_RESTART=0
Environment=CTC_MAX_BODY_BYTES=16777216
ExecStart=/opt/ctc/.venv/bin/ctc
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=ctc
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
