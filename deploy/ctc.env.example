# Install as /etc/ctc/ctc.env with owner root:ctc and mode 0640.
# Do not commit the real file. Generate tokens with: openssl rand -hex 32

CTC_UPSTREAM_BASE_URL=https://api.example.invalid/v1
CTC_UPSTREAM_API_KEY=
CTC_ADMIN_TOKEN=generate-a-random-admin-token

# LAN access is disabled unless both values are explicitly enabled.
# CTC_LAN_PROXY_HOST=0.0.0.0
# CTC_LAN_PROXY_PORT=8799
# CTC_PROXY_TOKEN=generate-a-separate-random-proxy-token

# Optional trusted reverse proxies allowed to supply X-Forwarded-For.
# CTC_TRUSTED_PROXY_HOSTS=127.0.0.1,::1

# Advanced overrides.
# CTC_FORWARDED_USER_AGENT=
# CTC_ALLOW_PROFILE_HEADER=0
# CTC_ALLOW_SELF_RESTART=0
# CTC_REQUEST_TIMEOUT_SECONDS=240
# CTC_STREAM_TIMEOUT_SECONDS=600
# CTC_MAX_BODY_BYTES=16777216
